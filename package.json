{
  "name": "github-release-notifier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/runMigrations.js",
    "notification:dev": "node --watch services/notification-service/src/server.js",
    "notification:start": "node services/notification-service/src/server.js",
    "test": "node tests/run-tests.mjs all",
    "test:unit": "node tests/run-tests.mjs unit",
    "test:integration": "node tests/run-tests.mjs integration",
    "test:e2e": "node tests/run-tests.mjs e2e",
    "test:e2e:install": "node tests/run-tests.mjs e2e:install",
    "test:watch": "vitest --config tests/vitest.unit.config.mjs",
    "arch:check": "vitest run --config tests/vitest.unit.config.mjs tests/unit/architectureDependencies.unit.test.js",
    "proto:lint": "node scripts/run-buf.mjs lint",
    "proto:generate": "node scripts/run-buf.mjs generate",
    "proto:check": "npm run proto:lint && npm run proto:generate",
    "benchmark:notification-transport": "node scripts/benchmark-notification-transport.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@notifier/shared": "*",
    "@bufbuild/protobuf": "^2.12.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "js-yaml": "^4.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.21.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "supertest": "^7.0.0",
    "vitest": "^4.1.8"
  }
}
