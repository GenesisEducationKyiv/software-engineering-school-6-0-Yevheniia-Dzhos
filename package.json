{
  "name": "github-release-notifier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/runMigrations.js",
    "notification:dev": "node --watch services/notification-service/src/server.js",
    "notification:start": "node services/notification-service/src/server.js",
    "test": "node tests/run-tests.mjs all",
    "test:unit": "node tests/run-tests.mjs unit",
    "test:integration": "node tests/run-tests.mjs integration",
    "test:e2e": "node tests/run-tests.mjs e2e",
    "test:e2e:install": "node tests/run-tests.mjs e2e:install",
    "test:watch": "vitest --config tests/vitest.unit.config.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "js-yaml": "^4.2.0",
    "nodemailer": "^8.0.11",
    "pg": "^8.21.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "supertest": "^7.0.0",
    "vitest": "^4.1.8"
  }
}
