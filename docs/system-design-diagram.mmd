flowchart LR
    user["User / Browser<br/>- Subscribe<br/>- Confirm email<br/>- Unsubscribe<br/>- View docs"]
    app["Express API (Monolith)<br/>- POST /api/subscribe<br/>- GET /api/confirm/:token<br/>- GET /api/unsubscribe/:token<br/>- GET /api/subscriptions<br/>- GET /health<br/>- GET /docs"]
    db["PostgreSQL<br/>- repositories<br/>- subscriptions<br/>- confirmation and unsubscribe tokens<br/>- last_seen_tag<br/>- timestamps"]
    github["GitHub API<br/>- Validate repository<br/>- Get latest release"]
    email["Email Service<br/>- Confirmation emails<br/>- Release notifications<br/>- Unsubscribe links<br/>- MailHog / Nodemailer"]
    scanner["Background Scanner (Scheduler)<br/>- Runs every SCAN_INTERVAL_MS<br/>- Fetch latest releases from GitHub<br/>- Compare with last_seen_tag<br/>- Notify confirmed subscribers<br/>- Update last_seen_tag"]

    user -->|"HTTPS"| app
    app -->|"SQL"| db
    app -->|"HTTP REST"| github
    app -->|"SMTP"| email
    scanner -->|"SQL read/write"| db
    scanner -->|"HTTP REST"| github
    scanner -->|"Send release notifications"| email